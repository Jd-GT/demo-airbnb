FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY demoairbnb/ ./demoairbnb/
COPY init_db.sh /app/init_db.sh

RUN python demoairbnb/manage.py makemigrations core inventory crm booking finance ops

ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=demoairbnb.settings

EXPOSE 8000

CMD ["/app/init_db.sh"]
