###############################################################################
# PRODUCTION ENV — copia a `.env.production` y llena todos los valores
#
# Cómo usarlo (en el Droplet de DigitalOcean):
#   cp .env.production.example .env.production
#   nano .env.production          # llena los valores reales
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
###############################################################################

# ----- Dominio / IP pública -----
# Sin dominio: pon la IP pública del Droplet (ej: 167.99.10.20)
# Con dominio: pon el dominio (ej: pms.miempresa.com)
DOMAIN=167.99.10.20

# ----- Django -----
# Genera con: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambiame-genera-uno-con-secrets-token-urlsafe-64

# Genera con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJANGO_FERNET_KEY=cambiame-genera-uno-con-fernet-generate-key

# Hosts permitidos — pon la IP o dominio del servidor
DJANGO_ALLOWED_HOSTS=167.99.10.20

# URL pública del API (lo que el navegador del usuario ve)
NEXT_PUBLIC_API_URL=http://167.99.10.20

# CORS y CSRF — mismo origen que el frontend
DJANGO_CORS_ALLOWED_ORIGINS=http://167.99.10.20
DJANGO_CSRF_TRUSTED_ORIGINS=http://167.99.10.20

# HSTS — déjalo en 0 hasta que tengas HTTPS funcionando
DJANGO_HSTS_SECONDS=0

# Gunicorn workers (regla: 2 × vCPUs + 1)
GUNICORN_WORKERS=3

# ----- Postgres -----
POSTGRES_DB=pms
POSTGRES_USER=pms_app
# Genera con: openssl rand -base64 24
POSTGRES_PASSWORD=cambiame-genera-uno-con-openssl-rand-base64-24

# ----- Super-admin (se crea al primer arranque) -----
SUPERADMIN_EMAIL_1=admin@tuempresa.com
SUPERADMIN_PASSWORD_1=cambiame-password-seguro
SUPERADMIN_NAME_1=Administrador

# Segundo admin opcional — deja vacío si solo necesitas uno
SUPERADMIN_EMAIL_2=
SUPERADMIN_PASSWORD_2=
SUPERADMIN_NAME_2=

# Poner en 1 si necesitas resetear contraseña de admin en un re-arranque
SUPERADMIN_RESET=0

# 0 = NO crear datos de demostración (recomendado en producción)
# 1 = sí crear tenant demo + 3 propiedades de ejemplo
SEED_DEMO_TENANT=0
