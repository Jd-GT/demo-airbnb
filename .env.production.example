###############################################################################
# PRODUCTION ENV — COPY TO `.env.production` AND CAMBIA TODOS LOS SECRETS
#
# Cómo usarlo (en la VM Azure):
#   cp .env.production.example .env.production
#   nano .env.production              # llena los valores
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
###############################################################################

# ----- Dominio público (lo que apunta tu DNS a la IP de la VM) -----
# Si todavía no tienes dominio, pon la IP pública aquí — Caddy le servirá
# por HTTP (sin certificado). Cuando consigas DNS, sólo cambias DOMAIN
# y reinicias caddy.
DOMAIN=mi-pms.example.com

# ----- Django -----
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambiame-genera-uno-con-secrets-token-urlsafe-64

# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJANGO_FERNET_KEY=cambiame-genera-uno-con-fernet-generate-key

# Hosts permitidos. Incluye el dominio + IP por si entras directo.
DJANGO_ALLOWED_HOSTS=mi-pms.example.com,20.30.40.50

# El frontend va a hablar al MISMO dominio (Caddy lo proxea). El
# NEXT_PUBLIC_API_URL es lo que el navegador del usuario ve.
NEXT_PUBLIC_API_URL=https://mi-pms.example.com

# CORS — el frontend es del mismo origen así que técnicamente no necesita
# CORS, pero dejamos uno por si pruebas desde otro host.
DJANGO_CORS_ALLOWED_ORIGINS=https://mi-pms.example.com

# CSRF — debe coincidir con el origen donde corre el frontend.
DJANGO_CSRF_TRUSTED_ORIGINS=https://mi-pms.example.com

# HSTS — pon 31536000 (1 año) cuando confirmes que HTTPS funciona y nunca
# vas a volver a HTTP. Empieza en 0.
DJANGO_HSTS_SECONDS=0

# Gunicorn workers (2 * vCPU + 1 es la regla clásica)
GUNICORN_WORKERS=3

# ----- Postgres -----
POSTGRES_DB=pms
POSTGRES_USER=pms_app
# Genera con: openssl rand -base64 24
POSTGRES_PASSWORD=cambiame-genera-uno-con-openssl-rand-base64-24

# ----- Super-admins (se crean al primer arranque) -----
SUPERADMIN_EMAIL_1=admin@admin.com
SUPERADMIN_PASSWORD_1=cambiame-en-prod
SUPERADMIN_EMAIL_2=afprietol2005@gmail.com
SUPERADMIN_PASSWORD_2=cambiame-en-prod

# Si pones SUPERADMIN_RESET=1 en un re-arranque, los superusers existentes
# tomarán la nueva contraseña. Útil si te bloqueaste. Vuélvelo a 0 después.
SUPERADMIN_RESET=0

# 0 = NO crear el tenant demo (recomendado en prod).
# 1 = sí crear demo@demo.com + 3 propiedades de ejemplo (útil para mostrar).
SEED_DEMO_TENANT=0
