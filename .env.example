# Copy to .env and fill in real values.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (used when redirecting back from OAuth callbacks)
FRONTEND_URL=http://localhost:3000

# Postgres (optional; falls back to SQLite when POSTGRES_DB is empty)
# POSTGRES_DB=demoairbnb
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Encryption key for stored credentials (refresh tokens, etc.)
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Google Calendar OAuth (https://console.cloud.google.com/apis/credentials)
# The redirect URI below MUST match the one configured in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google-calendar/oauth-callback/
