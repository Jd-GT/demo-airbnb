FROM node:22-alpine AS base

RUN apk add --no-cache libc6-compat

FROM base AS deps

WORKDIR /app

COPY frontend/demo-airbnb/package.json frontend/demo-airbnb/package-lock.json* ./
RUN npm ci

FROM base AS builder

WORKDIR /app

# Next.js inlines NEXT_PUBLIC_* env vars at build time, so they have
# to be present DURING `npm run build`, not just at runtime. The
# compose file passes this as a build arg in prod.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/demo-airbnb/ .

RUN npm run build

FROM base AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next

# Next.js needs to write the on-demand image-optimizer cache at runtime.
# Create it explicitly so we don't depend on COPY producing the dir.
RUN mkdir -p /app/.next/cache/images && chown -R nextjs:nodejs /app/.next

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node_modules/.bin/next", "start"]